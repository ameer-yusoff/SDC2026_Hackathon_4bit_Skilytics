# Copy src/.env.example to src/.env for local development.
# This root template uses the same settings. Never commit real credentials.

# A separate development database; direct URL is used by Drizzle schema setup.
DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@host/neondb?sslmode=require

PORT=5000
NODE_ENV=development
LOG_LEVEL=info
SESSION_SECRET=replace_with_a_unique_random_secret

# Active AI service. A real Gemini key is needed for uploaded-CV AI extraction.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_CV_MODEL=gemini-3.1-flash-lite
AI_AGENT_ROUTING=gemini-only
RUNPOD_ENABLE_GENERATION=false

# Optional RunPod integration, paused to conserve credits.
# To activate the supported hybrid routes, set AI_AGENT_ROUTING=hybrid,
# RUNPOD_ENABLE_GENERATION=true and provide private credentials/endpoints.
RUNPOD_API_KEY=
RUNPOD_LLM_ENDPOINT_ID=
RUNPOD_LIGHT_ENDPOINT_ID=
RUNPOD_LLM_MODEL=qwen/qwen3.5-27b
RUNPOD_LIGHT_MODEL=qwen/qwen3.5-9b

# Optional local frontend/API connection overrides (default API port: 5000).
# VITE_PORT=3000
# API_URL=http://localhost:5000
# VITE_API_URL=http://localhost:5000

# Optional deterministic test engine; not a real AI extraction service.
# AI_TEST_MODE=true
